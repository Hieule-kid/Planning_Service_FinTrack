# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── GitHub Packages (build-time only, to resolve com.fintrack:core) ──────────
# A PAT with `read:packages` scope. Needed by `docker compose build` and by
# `./mvnw -s settings.xml ...` when building locally. See README.
GITHUB_ACTOR=
GITHUB_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Eureka / Config Service (runs in the Fintrack repo, separate container) ──
# Reachable hostname/IP from inside this repo's containers.
EUREKA_HOST=host.docker.internal
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka123

# ── JWT (must be identical across auth-service and planning-service) ─────────
# Generate one with: openssl rand -base64 48
# Do not use a placeholder value; the service rejects weak or known secrets.
FINTRACK_JWT_SECRET=

# ── Gemini AI ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── CORS: allowed frontend origin ─────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
