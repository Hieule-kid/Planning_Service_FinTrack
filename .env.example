# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Eureka / Config Service (runs in the Fintrack repo, separate container) ──
# Reachable hostname/IP from inside this repo's containers.
EUREKA_HOST=host.docker.internal
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka123

# ── JWT (must be identical across auth-service and planning-service) ─────────
# Generate one with: openssl rand -base64 48
# Do not use a placeholder value; the service rejects weak or known secrets.
FINTRACK_JWT_SECRET=

# ── Gemini AI ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── CORS: allowed frontend origin ─────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
